# Copy this file to `.env` inside backend/ and adjust if needed.
# Read by app/core/config.py via pydantic-settings.
# Run the server from inside backend/ so the .env file is found.

# Display name returned by the API
APP_NAME=pdf-studio

# Version string returned by GET /api/health
APP_VERSION=0.1.0

# The single origin allowed by CORS (the Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Largest PDF accepted, in megabytes (a positive whole number)
MAX_UPLOAD_MB=100

# Minutes before an old upload or an undownloaded result is swept away
JOB_TTL_MINUTES=30

# How many PDFs may be compressed at the same time
MAX_CONCURRENT_JOBS=2