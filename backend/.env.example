# Copy this file to `.env` inside backend/ and adjust if needed.
# Read by app/core/config.py via pydantic-settings.
# Run the server from inside backend/ so the .env file is found.

# Display name returned by the API
APP_NAME=pdf-studio

# Version string returned by GET /api/health
APP_VERSION=0.1.0

# The single origin allowed by CORS (the Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000

# Largest PDF accepted, in megabytes (a positive whole number)
MAX_UPLOAD_MB=100

# Minutes before an old upload or an undownloaded result is swept away
JOB_TTL_MINUTES=30

# Compatibility setting. PyMuPDF work is serialized across all tools.
MAX_CONCURRENT_JOBS=1

# Most pages converted in one PDF to JPG job (a positive whole number)
MAX_PDF_PAGES=300

# Most images accepted in one JPG to PDF job. The frontend mirrors this as
# NEXT_PUBLIC_MAX_IMAGES; the backend stays the authority.
MAX_IMAGES=50

# Most pixels rendered for one PDF page. A larger page is rendered at a lower
# DPI instead of failing.
MAX_RENDER_PIXELS=30000000

# Most PDFs accepted in one Merge PDF job (a positive whole number)
MAX_MERGE_FILES=20
