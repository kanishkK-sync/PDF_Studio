# Copy this file to `.env.local` inside frontend/ and adjust if needed.
# Restart `next dev` after any change: NEXT_PUBLIC_* values are inlined
# into the browser bundle when the dev server or build starts.

# Base URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Largest file the upload form accepts, in megabytes. This must match the
# backend's MAX_UPLOAD_MB. It only saves a doomed upload; the backend stays
# the authority and rejects anything larger.
NEXT_PUBLIC_MAX_UPLOAD_MB=100