# ─── OS ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors / IDEs ────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Environment files (keep the examples) ─────────
.env
.env.*
!.env.example

# ─── Logs ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ═══ Frontend (Next.js) ════════════════════════════
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/next-env.d.ts
frontend/*.tsbuildinfo
frontend/.eslintcache
frontend/.vercel/

# ═══ Backend (FastAPI / Python) ════════════════════
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.coverage
backend/htmlcov/
backend/*.egg-info/
backend/dist/
backend/build/

# ═══ Runtime storage (contents ignored, folders kept) ═
backend/app/storage/uploads/*
!backend/app/storage/uploads/.gitkeep
backend/app/storage/outputs/*
!backend/app/storage/outputs/.gitkeep